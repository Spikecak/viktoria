---
import "../styles/global.css";
import "@fontsource/bodoni-moda/400.css";
import "@fontsource/bodoni-moda/400-italic.css";
import "@fontsource/bodoni-moda/500.css";
import "@fontsource/bodoni-moda/500-italic.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/500.css";
import Nav from "../components/Nav.astro";

export interface Props {
  title: string;
  description?: string;
  navSolid?: boolean;
}

const {
  title,
  description = "Restaurace Viktoria — Autentická Ukrajinská Kuchyně v Praze",
  navSolid = false,
} = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      if (location.hash && "scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
    </script>
  </head>
  <body>
    <Nav solid={navSolid} />
    <slot />

    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const layers = reducedMotion
        ? []
        : ([...document.querySelectorAll("[data-parallax]")] as HTMLElement[]);

      const updateParallax = () => {
        const viewH = window.innerHeight;
        for (const el of layers) {
          const revealParent = el.closest("[data-reveal]");
          if (revealParent && !revealParent.classList.contains("revealed")) continue;

          const rect = el.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > viewH) continue;

          const speed = Number(el.dataset.parallax) || 8;
          const progress = (viewH - rect.top) / (viewH + rect.height);
          el.style.transform = `translate3d(0, ${(progress - 0.5) * speed}%, 0)`;
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
              if (layers.length) updateParallax();
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll("[data-reveal]").forEach((el) => {
        observer.observe(el);
      });

      if (layers.length) {
        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              updateParallax();
              ticking = false;
            });
          },
          { passive: true }
        );
        window.addEventListener("resize", updateParallax, { passive: true });
        updateParallax();
      }

      const navEl = document.getElementById("site-nav");
      const WHEEL_SCALE = 0.90;
      const LERP = 0.06875;
      const keys = new Set(["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "]);

      let currentY = window.scrollY;
      let targetY = window.scrollY;
      let scrolling = false;
      let hashScroll = false;
      let hashOrigin = 0;
      let hashT0 = 0;
      let hashDuration = 0;

      const maxY = () =>
        Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

      const easeInOutCubic = (t: number) =>
        t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;

      const lockY = (el: Element) => {
        const content =
          el.querySelector(":scope > .site-container") ??
          el.querySelector(".site-container") ??
          el;
        const navH = navEl?.getBoundingClientRect().height ?? 72;
        const y =
          content.getBoundingClientRect().top + window.scrollY - navH - 20;
        return Math.max(0, Math.min(y, maxY()));
      };

      const tickScroll = (now: number) => {
        if (hashScroll) {
          const t = Math.min(1, (now - hashT0) / hashDuration);
          currentY = hashOrigin + (targetY - hashOrigin) * easeInOutCubic(t);
          if (t >= 1) {
            currentY = targetY;
            scrolling = false;
            hashScroll = false;
          }
        } else {
          currentY += (targetY - currentY) * LERP;
          if (Math.abs(targetY - currentY) < 0.4) {
            currentY = targetY;
            scrolling = false;
          }
        }
        window.scrollTo(0, currentY);
        if (scrolling) requestAnimationFrame(tickScroll);
      };

      const goTo = (y: number, asHash = false) => {
        if (reducedMotion) {
          hashScroll = false;
          scrolling = false;
          currentY = y;
          targetY = y;
          window.scrollTo(0, y);
          return;
        }
        targetY = Math.max(0, Math.min(y, maxY()));
        if (asHash) {
          hashScroll = true;
          hashOrigin = currentY;
          hashT0 = performance.now();
          hashDuration = Math.min(2200, Math.max(1400, Math.abs(targetY - hashOrigin) * 0.85));
        } else {
          hashScroll = false;
        }
        if (!scrolling) {
          scrolling = true;
          requestAnimationFrame(tickScroll);
        }
      };

      const scrollToHash = (hash: string) => {
        if (!hash || hash === "#") return;
        const id = decodeURIComponent(hash.slice(1));
        const el = document.getElementById(id);
        if (!el) return;
        currentY = window.scrollY;
        goTo(lockY(el), true);
      };

      const samePageHash = (anchor: HTMLAnchorElement) => {
        const url = new URL(anchor.href, window.location.href);
        if (!url.hash) return null;
        if (url.pathname !== window.location.pathname) return null;
        return url;
      };

      const menuOpen = () => document.body.style.overflow === "hidden";

      if (!reducedMotion) {
        window.addEventListener(
          "wheel",
          (event) => {
            if (event.ctrlKey || menuOpen() || event.defaultPrevented) return;
            if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
            event.preventDefault();
            const from = hashScroll ? currentY : targetY;
            goTo(from + event.deltaY * WHEEL_SCALE);
          },
          { passive: false }
        );

        window.addEventListener("keydown", (event) => {
          if (!keys.has(event.key) || event.defaultPrevented || menuOpen()) return;
          const tag = (event.target as HTMLElement | null)?.tagName;
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          if ((event.target as HTMLElement | null)?.isContentEditable) return;

          event.preventDefault();
          const page = window.innerHeight * 0.78;
          if (event.key === "Home") goTo(0);
          else if (event.key === "End") goTo(maxY());
          else if (event.key === "ArrowDown") goTo(targetY + 72);
          else if (event.key === "ArrowUp") goTo(targetY - 72);
          else if (event.key === "PageDown" || (event.key === " " && !event.shiftKey)) {
            goTo(targetY + page);
          } else {
            goTo(targetY - page);
          }
        });

        window.addEventListener(
          "scroll",
          () => {
            if (scrolling) return;
            currentY = window.scrollY;
            targetY = window.scrollY;
          },
          { passive: true }
        );

        window.addEventListener("resize", () => {
          targetY = Math.max(0, Math.min(targetY, maxY()));
        }, { passive: true });
      }

      document.addEventListener("click", (event) => {
        const anchor = (event.target as Element | null)?.closest("a");
        if (!anchor || event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const url = samePageHash(anchor);
        if (!url) return;
        event.preventDefault();
        if (url.hash !== window.location.hash) {
          history.pushState(null, "", url.hash);
        }
        scrollToHash(url.hash);
      });

      window.addEventListener("popstate", () => {
        if (location.hash) scrollToHash(location.hash);
        else goTo(0, true);
      });

      if (location.hash) {
        window.scrollTo(0, 0);
        currentY = 0;
        targetY = 0;
        requestAnimationFrame(() => scrollToHash(location.hash));
      }
    </script>
  </body>
</html>
