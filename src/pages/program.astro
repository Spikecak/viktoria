---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const monthNames = [
  "leden",
  "únor",
  "březen",
  "duben",
  "květen",
  "červen",
  "červenec",
  "srpen",
  "září",
  "říjen",
  "listopad",
  "prosinec",
];

const weekdays = ["Po", "Út", "St", "Čt", "Pá", "So", "Ne"];

const events = [
  {
    date: "2026-09-26",
    time: "18:00",
    title: "Večer varenyků",
    body: "Ruční příprava a společná degustace klasických i sezónních náplní. Hosté ochutnají tři druhy varenyků se zakysanou smetanou a osmaženou cibulí.",
    image:
      "https://images.unsplash.com/photo-1496116218417-1a781b1c416c?w=1400&q=80&auto=format&fit=crop",
    alt: "Ručně tvarované varenyky připravené k degustaci",
  },
  {
    date: "2026-10-10",
    time: "20:00",
    title: "Live hudba u stolu",
    body: "Sobotní večer s živou kytarou a lidovými melodiemi. Posezení v sále, domácí kuchyně a sklenka vína dlouho do noci.",
    image:
      "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=1400&q=80&auto=format&fit=crop",
    alt: "Hudebník s kytarou při živém vystoupení",
  },
  {
    date: "2026-11-06",
    time: "19:00",
    title: "Degustace ukrajinských vín",
    body: "Šest vzorků z oblastí Šabo a Zakarpattia v párování s borščem, sýrovými varenyky a domácím chlebem. Výklad sommeliéra v češtině.",
    image:
      "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=1400&q=80&auto=format&fit=crop",
    alt: "Sklenky červeného vína připravené k degustaci",
  },
  {
    date: "2026-12-19",
    time: "18:30",
    title: "Sváteční večeře",
    body: "Předvánoční menu podle rodinných receptů — kutia, holubtsi a medivnyk. Omezený počet míst, rezervace nutná.",
    image:
      "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1400&q=80&auto=format&fit=crop",
    alt: "Svátečně prostřený stůl s talířem hlavního chodu",
  },
];

const eventByDate = Object.fromEntries(events.map((event) => [event.date, event]));

function pad(n: number) {
  return String(n).padStart(2, "0");
}

function isoDate(year: number, month: number, day: number) {
  return `${year}-${pad(month)}-${pad(day)}`;
}

function capitalize(value: string) {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function leadingBlanks(year: number, month: number) {
  const sundayIndex = new Date(year, month - 1, 1).getDay();
  return (sundayIndex + 6) % 7;
}

function daysInMonth(year: number, month: number) {
  return new Date(year, month, 0).getDate();
}

const months = [
  { year: 2026, month: 9 },
  { year: 2026, month: 10 },
  { year: 2026, month: 11 },
  { year: 2026, month: 12 },
];

const todayIso = new Date().toISOString().slice(0, 10);
const defaultEvent = events.find((event) => event.date >= todayIso) ?? events[0];
const defaultMonthKey = defaultEvent.date.slice(0, 7);

function eventParts(date: string) {
  const [year, month, day] = date.split("-");
  return {
    day: String(Number(day)),
    monthName: monthNames[Number(month) - 1],
    year,
  };
}

const initialParts = eventParts(defaultEvent.date);
---

<BaseLayout
  title="Program — Viktoria Restaurant"
  description="Aktuální program Viktoria Restaurant — kalendář večerů, degustací a sváteční večeře v Praze 10."
  navSolid
>
  <main class="program-page">

    <header class="program-hero">
      <div class="site-container">
        <p class="eyebrow">Program</p>
        <h1 class="program-hero__title">Co se u nás děje</h1>
        <p class="program-hero__sub">
          Označené dny v kalendáři patří večerům u Viktorie. Klikněte na datum —
          objeví se fotografie a detaily večera.
        </p>
      </div>
    </header>

    <section class="program-board site-container" aria-label="Kalendář večerů">
      <div class="program-cal" data-calendar data-events={JSON.stringify(events)}>
        <div class="cal__nav">
          <button
            type="button"
            class="cal__arrow"
            data-cal-prev
            aria-label="Předchozí měsíc"
            disabled={defaultMonthKey === `${months[0].year}-${pad(months[0].month)}`}
          >
            ‹
          </button>
          <p class="cal__month" data-cal-label>
            {capitalize(monthNames[Number(defaultMonthKey.slice(5)) - 1])} {defaultMonthKey.slice(0, 4)}
          </p>
          <button type="button" class="cal__arrow" data-cal-next aria-label="Následující měsíc">
            ›
          </button>
        </div>

        {
          months.map((item) => {
            const key = `${item.year}-${pad(item.month)}`;
            const blanks = leadingBlanks(item.year, item.month);
            const count = daysInMonth(item.year, item.month);
            const cells: Array<number | null> = [
              ...Array.from({ length: blanks }, () => null),
              ...Array.from({ length: count }, (_, i) => i + 1),
            ];

            return (
              <div
                class:list={["cal__month-grid", { "is-active": key === defaultMonthKey }]}
                data-month={key}
              >
                <div class="cal__weekdays" aria-hidden="true">
                  {weekdays.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>
                <div class="cal__days">
                  {cells.map((day) => {
                    if (!day) return <span class="cal__blank"></span>;
                    const date = isoDate(item.year, item.month, day);
                    const event = eventByDate[date];
                    const isToday = date === todayIso;

                    if (event) {
                      const selected = date === defaultEvent.date;
                      return (
                        <button
                          type="button"
                          class:list={[
                            "cal__day",
                            "cal__day--event",
                            { "is-selected": selected, "cal__day--today": isToday },
                          ]}
                          data-date={date}
                          aria-pressed={selected}
                          aria-label={`${day}. ${monthNames[item.month - 1]} ${item.year}, ${event.title}`}
                        >
                          {day}
                        </button>
                      );
                    }

                    return (
                      <span
                        class:list={["cal__day", { "cal__day--today": isToday }]}
                      >
                        {day}
                      </span>
                    );
                  })}
                </div>
              </div>
            );
          })
        }

        <ol class="cal__upcoming">
          {
            events.map((event) => {
              const parts = eventParts(event.date);
              return (
                <li>
                  <button
                    type="button"
                    class:list={["cal__upcoming-btn", { "is-current": event.date === defaultEvent.date }]}
                    data-date={event.date}
                  >
                    <span>
                      {parts.day}. {parts.monthName}
                    </span>
                    <span>{event.title}</span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>

      <article class="program-stage" data-stage data-current-date={defaultEvent.date} aria-live="polite">
        <div class="stage__media">
          <img
            data-stage-image
            class="is-visible"
            src={defaultEvent.image}
            alt={defaultEvent.alt}
          />
          <img data-stage-image-next alt="" />
        </div>
        <div class="stage__copy">
          <p class="stage__when">
            <span class="stage__num" data-stage-day>{initialParts.day}</span>
            <span class="stage__month" data-stage-month>{initialParts.monthName}</span>
            <span class="stage__time" data-stage-time>{defaultEvent.time}</span>
          </p>
          <h2 class="stage__title" data-stage-title>{defaultEvent.title}</h2>
          <p class="stage__body" data-stage-body>{defaultEvent.body}</p>
          <a href="tel:+420601601216" class="stage__cta">
            Rezervace
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  type ProgramEvent = {
    date: string;
    time: string;
    title: string;
    body: string;
    image: string;
    alt: string;
  };

  const monthNames = [
    "leden",
    "únor",
    "březen",
    "duben",
    "květen",
    "červen",
    "červenec",
    "srpen",
    "září",
    "říjen",
    "listopad",
    "prosinec",
  ];

  const calendar = document.querySelector("[data-calendar]");
  const events: ProgramEvent[] = JSON.parse(calendar?.getAttribute("data-events") || "[]");
  const eventByDate = Object.fromEntries(events.map((event) => [event.date, event]));
  const monthGrids = [...document.querySelectorAll<HTMLElement>("[data-month]")];
  const monthLabel = document.querySelector("[data-cal-label]");
  const prevBtn = document.querySelector("[data-cal-prev]");
  const nextBtn = document.querySelector("[data-cal-next]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const stageDay = document.querySelector("[data-stage-day]");
  const stageMonth = document.querySelector("[data-stage-month]");
  const stageTime = document.querySelector("[data-stage-time]");
  const stageTitle = document.querySelector("[data-stage-title]");
  const stageBody = document.querySelector("[data-stage-body]");
  const stageImage = document.querySelector<HTMLImageElement>("[data-stage-image]");
  const stageImageNext = document.querySelector<HTMLImageElement>("[data-stage-image-next]");

  let activeMonth = document.querySelector<HTMLElement>(".cal__month-grid.is-active")?.dataset.month || "";

  const setMonth = (key: string) => {
    activeMonth = key;
    monthGrids.forEach((grid) => {
      const on = grid.dataset.month === key;
      grid.classList.toggle("is-active", on);
    });
    const [year, month] = key.split("-");
    if (monthLabel) {
      const name = monthNames[Number(month) - 1] || "";
      monthLabel.textContent = `${name.charAt(0).toUpperCase()}${name.slice(1)} ${year}`;
    }
    const index = monthGrids.findIndex((grid) => grid.dataset.month === key);
    prevBtn?.toggleAttribute("disabled", index <= 0);
    nextBtn?.toggleAttribute("disabled", index >= monthGrids.length - 1);
  };

  const selectEvent = (date: string) => {
    const event = eventByDate[date];
    if (!event) return;

    document.querySelectorAll<HTMLButtonElement>(".cal__day--event").forEach((btn) => {
      const on = btn.dataset.date === date;
      btn.classList.toggle("is-selected", on);
      btn.setAttribute("aria-pressed", String(on));
    });

    document.querySelectorAll<HTMLButtonElement>(".cal__upcoming-btn").forEach((btn) => {
      btn.classList.toggle("is-current", btn.dataset.date === date);
    });

    const stage = document.querySelector<HTMLElement>("[data-stage]");
    if (stage?.dataset.currentDate === date) {
      setMonth(date.slice(0, 7));
      return;
    }
    if (stage) stage.dataset.currentDate = date;

    const [, month, day] = date.split("-");
    if (stageDay) stageDay.textContent = String(Number(day));
    if (stageMonth) stageMonth.textContent = monthNames[Number(month) - 1] || "";
    if (stageTime) stageTime.textContent = event.time;
    if (stageTitle) stageTitle.textContent = event.title;
    if (stageBody) stageBody.textContent = event.body;

    if (stageImage && stageImageNext && stageImage.getAttribute("src") !== event.image) {
      const showNext = () => {
        stageImageNext.src = event.image;
        stageImageNext.alt = event.alt;
        stageImageNext.classList.add("is-visible");
        stageImage.classList.remove("is-visible");
        window.setTimeout(() => {
          stageImage.src = event.image;
          stageImage.alt = event.alt;
          stageImage.classList.add("is-visible");
          stageImageNext.classList.remove("is-visible");
        }, reducedMotion ? 0 : 520);
      };

      if (reducedMotion) {
        stageImage.src = event.image;
        stageImage.alt = event.alt;
      } else {
        showNext();
      }
    } else if (stageImage) {
      stageImage.alt = event.alt;
    }

    setMonth(date.slice(0, 7));
  };

  document.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.dataset.date) selectEvent(btn.dataset.date);
    });
  });

  prevBtn?.addEventListener("click", () => {
    const index = monthGrids.findIndex((grid) => grid.dataset.month === activeMonth);
    if (index > 0) setMonth(monthGrids[index - 1].dataset.month || activeMonth);
  });

  nextBtn?.addEventListener("click", () => {
    const index = monthGrids.findIndex((grid) => grid.dataset.month === activeMonth);
    if (index < monthGrids.length - 1) setMonth(monthGrids[index + 1].dataset.month || activeMonth);
  });

  setMonth(document.querySelector<HTMLElement>(".cal__month-grid.is-active")?.dataset.month || monthGrids[0]?.dataset.month || "");
</script>

<style>
  .program-page {
    padding-top: 5rem;
  }

  .program-hero {
    padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(2.5rem, 4vw, 4rem);
    background-color: var(--color-warm-white);
    border-bottom: 1px solid var(--color-border);
  }

  .program-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 500;
    font-style: italic;
    line-height: 0.97;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    margin: 0 0 1.25rem;
  }

  .program-hero__sub {
    font-size: 1rem;
    line-height: 1.72;
    color: var(--color-muted);
    max-width: 52ch;
    margin: 0;
  }

  .program-board {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .cal__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .cal__month {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 500;
    color: var(--color-charcoal);
    margin: 0;
  }

  .cal__arrow {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-charcoal);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .cal__arrow:hover:not(:disabled) {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    border-color: var(--color-charcoal);
  }

  .cal__arrow:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .cal__month-grid {
    display: none;
  }

  .cal__month-grid.is-active {
    display: block;
  }

  .cal__weekdays,
  .cal__days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }

  .cal__weekdays {
    margin-bottom: 0.5rem;
  }

  .cal__weekdays span {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
  }

  .cal__blank {
    min-height: 2.6rem;
  }

  .cal__day {
    position: relative;
    min-height: 2.6rem;
    display: grid;
    place-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-charcoal-soft);
    border: none;
    background: none;
    padding: 0;
  }

  .cal__day--event {
    width: 2.2rem;
    height: 2.2rem;
    min-height: 0;
    justify-self: center;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-charcoal);
    font-weight: 500;
  }

  .cal__day--event::after {
    content: "";
    position: absolute;
    bottom: 0.35rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-terracotta);
    transform: translateX(-50%);
  }

  .cal__day--event:hover {
    color: var(--color-terracotta);
  }

  .cal__day--today:not(.is-selected) {
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .cal__day--event.is-selected {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  .cal__day--event.is-selected::after {
    display: none;
  }

  .cal__upcoming {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cal__upcoming-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border: none;
    border-bottom: 1px solid transparent;
    background: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .cal__upcoming-btn span:first-child {
    letter-spacing: 0.04em;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .cal__upcoming-btn:hover,
  .cal__upcoming-btn.is-current {
    color: var(--color-charcoal);
  }

  .cal__upcoming-btn.is-current span:last-child {
    font-style: italic;
    font-family: var(--font-serif);
    font-size: 1rem;
  }

  .program-stage {
    display: grid;
    gap: 1.75rem;
  }

  .stage__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .stage__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .stage__media img.is-visible {
    opacity: 1;
  }

  .stage__when {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }

  .stage__num {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 500;
    color: var(--color-charcoal);
  }

  .stage__month {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-terracotta);
    text-transform: capitalize;
  }

  .stage__time {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stage__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-charcoal);
    margin: 0 0 0.85rem;
  }

  .stage__body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-charcoal-soft);
    max-width: 48ch;
    margin: 0 0 1.5rem;
  }

  .stage__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream);
    background-color: var(--color-terracotta);
    padding: 0.85rem 1.75rem;
    transition: background-color 0.25s ease;
  }

  .stage__cta:hover {
    background-color: var(--color-charcoal);
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__media img {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .program-board {
      grid-template-columns: 1fr;
    }

    .program-stage {
      order: -1;
    }
  }
</style>
