---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const monthNames = [
  "leden",
  "únor",
  "březen",
  "duben",
  "květen",
  "červen",
  "červenec",
  "srpen",
  "září",
  "říjen",
  "listopad",
  "prosinec",
];

const weekdays = ["Po", "Út", "St", "Čt", "Pá", "So", "Ne"];

const events = [
  {
    date: "2026-09-26",
    time: "18:00",
    title: "Večer varenyků",
    body: "Ruční příprava a společná degustace klasických i sezónních náplní. Hosté ochutnají tři druhy varenyků se zakysanou smetanou a osmaženou cibulí.",
    image:
      "https://images.unsplash.com/photo-1496116218417-1a781b1c416c?w=1400&q=80&auto=format&fit=crop",
    alt: "Ručně tvarované varenyky připravené k degustaci",
  },
  {
    date: "2026-10-10",
    time: "20:00",
    title: "Live hudba u stolu",
    body: "Sobotní večer s živou kytarou a lidovými melodiemi. Posezení v sále, domácí kuchyně a sklenka vína dlouho do noci.",
    image:
      "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=1400&q=80&auto=format&fit=crop",
    alt: "Hudebník s kytarou při živém vystoupení",
  },
  {
    date: "2026-11-06",
    time: "19:00",
    title: "Degustace ukrajinských vín",
    body: "Šest vzorků z oblastí Šabo a Zakarpattia v párování s borščem, sýrovými varenyky a domácím chlebem. Výklad sommeliéra v češtině.",
    image:
      "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=1400&q=80&auto=format&fit=crop",
    alt: "Sklenky červeného vína připravené k degustaci",
  },
  {
    date: "2026-12-19",
    time: "18:30",
    title: "Sváteční večeře",
    body: "Předvánoční menu podle rodinných receptů — kutia, holubtsi a medivnyk. Omezený počet míst, rezervace nutná.",
    image:
      "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1400&q=80&auto=format&fit=crop",
    alt: "Svátečně prostřený stůl s talířem hlavního chodu",
  },
];

const eventByDate = Object.fromEntries(events.map((event) => [event.date, event]));

function pad(n: number) {
  return String(n).padStart(2, "0");
}

function isoDate(year: number, month: number, day: number) {
  return `${year}-${pad(month)}-${pad(day)}`;
}

function capitalize(value: string) {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function leadingBlanks(year: number, month: number) {
  const sundayIndex = new Date(year, month - 1, 1).getDay();
  return (sundayIndex + 6) % 7;
}

function daysInMonth(year: number, month: number) {
  return new Date(year, month, 0).getDate();
}

const months = [
  { year: 2026, month: 9 },
  { year: 2026, month: 10 },
  { year: 2026, month: 11 },
  { year: 2026, month: 12 },
];

const todayIso = new Date().toISOString().slice(0, 10);
const defaultEvent = events.find((event) => event.date >= todayIso) ?? events[0];
const defaultMonthKey = defaultEvent.date.slice(0, 7);

function eventParts(date: string) {
  const [year, month, day] = date.split("-");
  return {
    day: String(Number(day)),
    monthName: monthNames[Number(month) - 1],
    year,
  };
}

const initialParts = eventParts(defaultEvent.date);
---

<BaseLayout
  title="Program — Viktoria Restaurant"
  description="Aktuální program Viktoria Restaurant — kalendář večerů, degustací a sváteční večeře v Praze 10."
  navSolid
>
  <main class="program-page">
    <h1 class="sr-only">Program</h1>

    <section class="program-board site-container" aria-label="Kalendář večerů">
      <div class="program-cal" data-calendar data-events={JSON.stringify(events)}>
        <div class="cal__nav">
          <button
            type="button"
            class="cal__arrow"
            data-cal-prev
            aria-label="Předchozí měsíc"
            disabled={defaultMonthKey === `${months[0].year}-${pad(months[0].month)}`}
          >
            ‹
          </button>
          <p class="cal__month" data-cal-label>
            {capitalize(monthNames[Number(defaultMonthKey.slice(5)) - 1])} {defaultMonthKey.slice(0, 4)}
          </p>
          <button type="button" class="cal__arrow" data-cal-next aria-label="Následující měsíc">
            ›
          </button>
        </div>

        {
          months.map((item) => {
            const key = `${item.year}-${pad(item.month)}`;
            const blanks = leadingBlanks(item.year, item.month);
            const count = daysInMonth(item.year, item.month);
            const cells: Array<number | null> = [
              ...Array.from({ length: blanks }, () => null),
              ...Array.from({ length: count }, (_, i) => i + 1),
            ];
            while (cells.length < 42) cells.push(null);

            return (
              <div
                class:list={["cal__month-grid", { "is-active": key === defaultMonthKey }]}
                data-month={key}
              >
                <div class="cal__weekdays" aria-hidden="true">
                  {weekdays.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>
                <div class="cal__days">
                  {cells.map((day) => {
                    if (!day) return <span class="cal__blank"></span>;
                    const date = isoDate(item.year, item.month, day);
                    const event = eventByDate[date];
                    const isToday = date === todayIso;

                    if (event) {
                      const selected = date === defaultEvent.date;
                      return (
                        <button
                          type="button"
                          class:list={[
                            "cal__day",
                            "cal__day--event",
                            { "is-selected": selected, "cal__day--today": isToday },
                          ]}
                          data-date={date}
                          aria-pressed={selected}
                          aria-label={`${day}. ${monthNames[item.month - 1]} ${item.year}, ${event.title}`}
                        >
                          {day}
                        </button>
                      );
                    }

                    return (
                      <span
                        class:list={["cal__day", { "cal__day--today": isToday }]}
                      >
                        {day}
                      </span>
                    );
                  })}
                </div>
              </div>
            );
          })
        }

        <ol class="cal__upcoming">
          {
            events.map((event) => {
              const parts = eventParts(event.date);
              return (
                <li>
                  <button
                    type="button"
                    class:list={["cal__upcoming-btn", { "is-current": event.date === defaultEvent.date }]}
                    data-date={event.date}
                  >
                    <span>
                      {parts.day}. {parts.monthName}
                    </span>
                    <span>{event.title}</span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>

      <article class="program-stage" data-stage data-current-date={defaultEvent.date} aria-live="polite">
        <div class="stage__media">
          <img
            data-stage-image
            class="is-visible"
            src={defaultEvent.image}
            alt={defaultEvent.alt}
          />
          <img data-stage-image-next alt="" />
        </div>
        <div class="stage__copy" data-stage-copy>
          <p class="stage__when">
            <span class="stage__num" data-stage-day>{initialParts.day}</span>
            <span class="stage__month" data-stage-month>{initialParts.monthName}</span>
            <span class="stage__sep" aria-hidden="true">/</span>
            <span class="stage__time" data-stage-time>{defaultEvent.time}</span>
          </p>
          <h2 class="stage__title" data-stage-title>{defaultEvent.title}</h2>
          <p class="stage__body" data-stage-body>{defaultEvent.body}</p>
        </div>
      </article>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  type ProgramEvent = {
    date: string;
    time: string;
    title: string;
    body: string;
    image: string;
    alt: string;
  };

  const monthNames = [
    "leden",
    "únor",
    "březen",
    "duben",
    "květen",
    "červen",
    "červenec",
    "srpen",
    "září",
    "říjen",
    "listopad",
    "prosinec",
  ];

  const calendar = document.querySelector("[data-calendar]");
  const events: ProgramEvent[] = JSON.parse(calendar?.getAttribute("data-events") || "[]");
  const eventByDate = Object.fromEntries(events.map((event) => [event.date, event]));
  const monthGrids = [...document.querySelectorAll<HTMLElement>("[data-month]")];
  const monthLabel = document.querySelector("[data-cal-label]");
  const prevBtn = document.querySelector("[data-cal-prev]");
  const nextBtn = document.querySelector("[data-cal-next]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const stageCopy = document.querySelector<HTMLElement>("[data-stage-copy]");
  const stageDay = document.querySelector("[data-stage-day]");
  const stageMonth = document.querySelector("[data-stage-month]");
  const stageTime = document.querySelector("[data-stage-time]");
  const stageTitle = document.querySelector("[data-stage-title]");
  const stageBody = document.querySelector("[data-stage-body]");
  let stageImage = document.querySelector<HTMLImageElement>("[data-stage-image]");
  let stageImageNext = document.querySelector<HTMLImageElement>("[data-stage-image-next]");
  const IMAGE_FADE_MS = 1000;
  const COPY_FADE_MS = 420;
  let imageFadeTimer = 0;
  let copyFadeTimer = 0;

  let activeMonth = document.querySelector<HTMLElement>(".cal__month-grid.is-active")?.dataset.month || "";

  const setMonth = (key: string) => {
    activeMonth = key;
    monthGrids.forEach((grid) => {
      const on = grid.dataset.month === key;
      grid.classList.toggle("is-active", on);
    });
    const [year, month] = key.split("-");
    if (monthLabel) {
      const name = monthNames[Number(month) - 1] || "";
      monthLabel.textContent = `${name.charAt(0).toUpperCase()}${name.slice(1)} ${year}`;
    }
    const index = monthGrids.findIndex((grid) => grid.dataset.month === key);
    prevBtn?.toggleAttribute("disabled", index <= 0);
    nextBtn?.toggleAttribute("disabled", index >= monthGrids.length - 1);
  };

  const selectEvent = (date: string) => {
    const event = eventByDate[date];
    if (!event) return;

    document.querySelectorAll<HTMLButtonElement>(".cal__day--event").forEach((btn) => {
      const on = btn.dataset.date === date;
      btn.classList.toggle("is-selected", on);
      btn.setAttribute("aria-pressed", String(on));
    });

    document.querySelectorAll<HTMLButtonElement>(".cal__upcoming-btn").forEach((btn) => {
      btn.classList.toggle("is-current", btn.dataset.date === date);
    });

    const stage = document.querySelector<HTMLElement>("[data-stage]");
    if (stage?.dataset.currentDate === date) {
      setMonth(date.slice(0, 7));
      return;
    }
    if (stage) stage.dataset.currentDate = date;

    const applyCopy = () => {
      const [, month, day] = date.split("-");
      if (stageDay) stageDay.textContent = String(Number(day));
      if (stageMonth) stageMonth.textContent = monthNames[Number(month) - 1] || "";
      if (stageTime) stageTime.textContent = event.time;
      if (stageTitle) stageTitle.textContent = event.title;
      if (stageBody) stageBody.textContent = event.body;
    };

    window.clearTimeout(copyFadeTimer);
    window.clearTimeout(imageFadeTimer);

    if (reducedMotion) {
      applyCopy();
    } else {
      stageCopy?.classList.add("is-fading");
      copyFadeTimer = window.setTimeout(() => {
        applyCopy();
        stageCopy?.classList.remove("is-fading");
      }, COPY_FADE_MS);
    }

    if (stageImage && stageImageNext && stageImage.getAttribute("src") !== event.image) {
      const outgoing = stageImage;
      const incoming = stageImageNext;

      const settleLayers = () => {
        outgoing.removeAttribute("data-stage-image");
        outgoing.setAttribute("data-stage-image-next", "");
        incoming.removeAttribute("data-stage-image-next");
        incoming.setAttribute("data-stage-image", "");
        outgoing.style.transition = "none";
        incoming.style.transition = "none";
        outgoing.classList.remove("is-visible");
        incoming.classList.add("is-visible");
        outgoing.removeAttribute("src");
        outgoing.alt = "";
        stageImage = incoming;
        stageImageNext = outgoing;
        void outgoing.offsetHeight;
        requestAnimationFrame(() => {
          outgoing.style.removeProperty("transition");
          incoming.style.removeProperty("transition");
        });
      };

      const showNext = () => {
        incoming.src = event.image;
        incoming.alt = event.alt;
        incoming.classList.add("is-visible");
        outgoing.classList.remove("is-visible");
        imageFadeTimer = window.setTimeout(settleLayers, IMAGE_FADE_MS + 40);
      };

      if (reducedMotion) {
        outgoing.src = event.image;
        outgoing.alt = event.alt;
      } else {
        showNext();
      }
    } else if (stageImage) {
      stageImage.alt = event.alt;
    }

    setMonth(date.slice(0, 7));
  };

  const eventDates = events.map((event) => event.date);
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  let swipeLock = false;
  let wheelAcc = 0;
  let wheelReset = 0;
  let pointer: { id: number; x: number; y: number } | null = null;

  const stepEvent = (dir: 1 | -1) => {
    if (swipeLock) return;
    const current = stage?.dataset.currentDate || "";
    const index = eventDates.indexOf(current);
    const next = index + dir;
    if (index < 0 || next < 0 || next >= eventDates.length) return;
    swipeLock = true;
    selectEvent(eventDates[next]);
    window.setTimeout(() => {
      swipeLock = false;
    }, 520);
  };

  if (stage) {
    stage.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
        event.preventDefault();
        wheelAcc += event.deltaX;
        window.clearTimeout(wheelReset);
        if (Math.abs(wheelAcc) >= 72) {
          stepEvent(wheelAcc > 0 ? 1 : -1);
          wheelAcc = 0;
        } else {
          wheelReset = window.setTimeout(() => {
            wheelAcc = 0;
          }, 140);
        }
      },
      { passive: false }
    );

    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
    });

    stage.addEventListener("pointerup", (event) => {
      if (!pointer || event.pointerId !== pointer.id) return;
      const dx = event.clientX - pointer.x;
      const dy = event.clientY - pointer.y;
      pointer = null;
      if (Math.abs(dx) < 46 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
      stepEvent(dx < 0 ? 1 : -1);
    });

    stage.addEventListener("pointercancel", () => {
      pointer = null;
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.dataset.date) selectEvent(btn.dataset.date);
    });
  });

  prevBtn?.addEventListener("click", () => {
    const index = monthGrids.findIndex((grid) => grid.dataset.month === activeMonth);
    if (index > 0) setMonth(monthGrids[index - 1].dataset.month || activeMonth);
  });

  nextBtn?.addEventListener("click", () => {
    const index = monthGrids.findIndex((grid) => grid.dataset.month === activeMonth);
    if (index < monthGrids.length - 1) setMonth(monthGrids[index + 1].dataset.month || activeMonth);
  });

  setMonth(document.querySelector<HTMLElement>(".cal__month-grid.is-active")?.dataset.month || monthGrids[0]?.dataset.month || "");
</script>

<style>
  .program-page {
    padding-top: 5rem;
  }

  .program-board {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: stretch;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    min-width: 0;
  }

  .cal__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .cal__month {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-style: italic;
    font-weight: 500;
    color: var(--color-heading);
    margin: 0;
  }

  .cal__arrow {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-charcoal);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .cal__arrow:hover:not(:disabled) {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    border-color: var(--color-charcoal);
  }

  .cal__arrow:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .cal__month-grid {
    display: none;
  }

  .cal__month-grid.is-active {
    display: block;
  }

  .cal__weekdays,
  .cal__days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }

  .cal__days {
    grid-template-rows: repeat(6, 2.6rem);
  }

  .cal__weekdays {
    margin-bottom: 0.5rem;
  }

  .cal__weekdays span {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
  }

  .cal__blank {
    min-height: 2.6rem;
  }

  .cal__day {
    position: relative;
    min-height: 2.6rem;
    display: grid;
    place-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    opacity: 0.4;
    border: none;
    background: none;
    padding: 0;
  }

  .cal__day--event {
    width: 2.2rem;
    height: 2.2rem;
    min-height: 0;
    justify-self: center;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-charcoal);
    font-weight: 500;
    opacity: 1;
  }

  .cal__day--event::after {
    content: "";
    position: absolute;
    bottom: 0.35rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-terracotta);
    transform: translateX(-50%);
  }

  .cal__day--event:hover {
    color: var(--color-terracotta);
  }

  .cal__day--today:not(.is-selected) {
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .cal__day--event.is-selected {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  .cal__day--event.is-selected::after {
    display: none;
  }

  .cal__upcoming {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cal__upcoming-btn {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    border: none;
    border-bottom: 1px solid transparent;
    background: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .cal__upcoming-btn span:first-child {
    letter-spacing: 0.04em;
    text-transform: capitalize;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .cal__upcoming-btn span:last-child {
    min-width: 0;
    text-align: right;
  }

  .cal__upcoming-btn:hover,
  .cal__upcoming-btn.is-current {
    color: var(--color-charcoal);
  }

  .program-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: calc(100svh - 13rem);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  .stage__media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    background-color: var(--color-charcoal);
  }

  .stage__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(26, 25, 23, 0.92) 0%,
      rgba(26, 25, 23, 0.55) 42%,
      rgba(26, 25, 23, 0) 72%
    );
    pointer-events: none;
  }

  .stage__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    -webkit-user-drag: none;
    user-select: none;
  }

  .stage__media img.is-visible {
    opacity: 1;
  }

  .stage__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.15rem, 3vw, 1.75rem) clamp(2.85rem, 6.5vw, 4.25rem);
    transition: opacity 0.42s ease;
  }

  .stage__copy.is-fading {
    opacity: 0;
  }

  .stage__when {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0 0 0.65rem;
  }

  .stage__num,
  .stage__time {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    font-weight: 500;
    color: var(--color-cream);
  }

  .stage__month {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: rgba(247, 243, 238, 0.62);
    text-transform: capitalize;
  }

  .stage__sep {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.4vw, 2.85rem);
    font-weight: 400;
    color: rgba(247, 243, 238, 0.42);
    line-height: 1;
  }

  .stage__title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-cream);
    margin: 0 0 0.7rem;
  }

  .stage__body {
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(247, 243, 238, 0.82);
    max-width: 46ch;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__media img,
    .stage__copy {
      transition: none;
