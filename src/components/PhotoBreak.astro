---

<section class="photo-break" aria-label="Pohled do restaurace">
  <div class="photo-break__clip">
    <img
      src="/hero-restaurant.jpg"
      alt="Interiér restaurace Viktoria — útulný sál s prostřenými stoly připravenými pro hosty"
      loading="lazy"
    />
  </div>
  <div class="photo-break__overlay" aria-hidden="true"></div>
</section>

<style>
  .photo-break {
    height: clamp(380px, 55vh, 680px);
    position: relative;
    overflow: hidden;
  }

  .photo-break__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo-break img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    object-position: 67% center;
    display: block;
    will-change: transform;
  }

  .photo-break__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 12, 0.25);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-break img {
      height: 100%;
      will-change: auto;
    }
  }
</style>

<script>
  const section = document.querySelector(".photo-break") as HTMLElement | null;
  const img = section?.querySelector("img") as HTMLImageElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && img && !reduced) {
    const onScroll = () => {
      const top = section.getBoundingClientRect().top;
      img.style.transform = `translate3d(0, ${-top}px, 0)`;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();
  }
</script>
