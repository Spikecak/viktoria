---
---

<section class="photo-break" aria-labelledby="photo-break-heading">
  <div class="photo-break__clip">
    <img
      src="/hero-restaurant.jpg"
      alt="Interiér restaurace Viktoria — útulný sál s prostřenými stoly připravenými pro hosty"
      loading="lazy"
    />
  </div>
  <div class="photo-break__overlay" aria-hidden="true"></div>
  <div class="photo-break__copy site-container">
    <h2 id="photo-break-heading" class="photo-break__title" data-reveal>
      Velký prostor pro velké chvíle
    </h2>
    <p class="photo-break__text" data-reveal data-reveal-delay="3">
      Oslavy, rodinná setkání i firemní akce. Dost místa pro všechny.
    </p>
  </div>
</section>

<style>
  .photo-break {
    --photo-break-h: clamp(380px, 55svh, 680px);
    height: var(--photo-break-h);
    position: relative;
    timeline-scope: --photo-break;
    view-timeline-name: --photo-break;
    view-timeline-axis: block;
  }

  .photo-break__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo-break img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    object-fit: cover;
    object-position: 67% center;
    display: block;
    pointer-events: none;
    will-change: transform;
    animation-name: photo-uncover;
    animation-duration: 1s;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --photo-break;
    animation-range: cover 0% cover 100%;
  }

  @keyframes photo-uncover {
    from {
      transform: translate3d(0, -100vh, 0);
    }
    to {
      transform: translate3d(0, var(--photo-break-h), 0);
    }
  }

  @supports (height: 100lvh) {
    @keyframes photo-uncover {
      from {
        transform: translate3d(0, -100lvh, 0);
      }
      to {
        transform: translate3d(0, var(--photo-break-h), 0);
      }
    }
  }

  .photo-break__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 12, 0.38);
    pointer-events: none;
  }

  .photo-break__copy {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .photo-break__title {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4.2vw, 3.5rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0;
    text-shadow: 0 1px 18px rgba(20, 16, 12, 0.35);
  }

  .photo-break__text {
    font-size: clamp(1.14rem, 1.68vw, 1.275rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 1.15rem 0 0;
    max-width: 34ch;
    text-shadow: 0 1px 14px rgba(20, 16, 12, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-break img {
      height: 100%;
      animation: none;
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  const section = document.querySelector(".photo-break") as HTMLElement | null;
  const img = section?.querySelector("img") as HTMLImageElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && img && !reduced) {
    let rafId = 0;
    let watching = false;

    const lockToViewport = () => {
      img.style.transform = `translate3d(0, ${-section.getBoundingClientRect().top}px, 0)`;
    };

    const stopRaf = () => {
      watching = false;
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const rafLoop = () => {
      if (!watching) return;
      lockToViewport();
      rafId = requestAnimationFrame(rafLoop);
    };

    const bindViewTimeline = () => {
      const ViewTimelineCtor = (
        window as Window & {
          ViewTimeline?: new (options: { subject: Element; axis?: string }) => AnimationTimeline;
        }
      ).ViewTimeline;
      if (typeof ViewTimelineCtor !== "function") return false;

      img.getAnimations().forEach((animation) => animation.cancel());
      img.style.animation = "none";

      const from = -img.offsetHeight;
      const to = section.offsetHeight;
      const keyframes = [
        { transform: `translate3d(0, ${from}px, 0)` },
        { transform: `translate3d(0, ${to}px, 0)` },
      ];
      const timeline = new ViewTimelineCtor({
        subject: section,
        axis: "block",
      });
      const base = {
        fill: "both" as FillMode,
        easing: "linear",
        duration: 1,
        timeline,
      };

      try {
        img.animate(keyframes, { ...base, rangeStart: "cover 0%", rangeEnd: "cover 100%" });
      } catch {
        img.animate(keyframes, { ...base, rangeStart: "cover", rangeEnd: "cover" });
      }
      return true;
    };

    const bind = () => {
      stopRaf();
      if (bindViewTimeline()) return;

      img.style.animation = "none";
      watching = true;
      rafLoop();
    };

    bind();
    window.addEventListener("resize", bind, { passive: true });
    window.addEventListener("orientationchange", () => {
      requestAnimationFrame(bind);
    });
  }
</script>
