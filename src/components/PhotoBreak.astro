---
---

<section class="photo-break" aria-labelledby="photo-break-heading">
  <div class="photo-break__clip">
    <img
      src="/hero-restaurant.jpg"
      alt="Interiér restaurace Viktoria — útulný sál s prostřenými stoly připravenými pro hosty"
      loading="lazy"
    />
  </div>
  <div class="photo-break__overlay" aria-hidden="true"></div>
  <div class="photo-break__copy site-container">
    <h2 id="photo-break-heading" class="photo-break__title" data-reveal>
      Velký prostor pro velké chvíle
    </h2>
    <p class="photo-break__text" data-reveal data-reveal-delay="3">
      Oslavy, rodinná setkání i firemní akce. Dost místa pro všechny.
    </p>
  </div>
</section>

<style>
  .photo-break {
    height: clamp(380px, 55vh, 680px);
    height: clamp(380px, 55svh, 680px);
    position: relative;
    overflow: hidden;
  }

  .photo-break__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .photo-break img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    object-fit: cover;
    object-position: 67% center;
    display: block;
    will-change: transform;
    pointer-events: none;
  }

  .photo-break__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 12, 0.38);
    pointer-events: none;
  }

  .photo-break__copy {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .photo-break__title {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4.2vw, 3.5rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0;
    text-shadow: 0 1px 18px rgba(20, 16, 12, 0.35);
  }

  .photo-break__text {
    font-size: clamp(1.14rem, 1.68vw, 1.275rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 1.15rem 0 0;
    max-width: 34ch;
    text-shadow: 0 1px 14px rgba(20, 16, 12, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-break img {
      height: 100%;
      will-change: auto;
    }
  }
</style>

<script>
  const section = document.querySelector(".photo-break") as HTMLElement | null;
  const img = section?.querySelector("img") as HTMLImageElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && img && !reduced) {
    const onScroll = () => {
      const top = section.getBoundingClientRect().top;
      img.style.transform = `translate3d(0, ${-top}px, 0)`;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("orientationchange", onScroll);
    onScroll();
  }
</script>
