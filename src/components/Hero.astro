---
---

<section class="hero" aria-label="Viktoria Restaurant — hlavní sekce">
  <div class="hero__bg">
    <img
      src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=2400&q=85&auto=format&fit=crop"
      alt=""
      role="presentation"
      fetchpriority="high"
      loading="eager"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <p class="hero__eyebrow">Autentická Ukrajinská Kuchyně</p>
  <h1 class="hero__title">
    <span class="hero__title-sr">Viktoria Restaurant</span>
    <span class="hero__title-main" aria-hidden="true">Viktoria</span>
    <span class="hero__title-sub" aria-hidden="true">
      {"Restaurant".split("").map((letter) => (
        <span>{letter}</span>
      ))}
    </span>
  </h1>
  <a href="#rezervace" class="hero__cta">
    Rezervace stolu
    <span aria-hidden="true" class="hero__cta-arrow">→</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 0.5fr auto auto 1fr auto 0.22fr;
    justify-items: center;
    align-items: center;
    padding: 5.75rem clamp(1.5rem, 5vw, 4rem) 2.5rem;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(26, 25, 23, 0.18) 0%,
      rgba(26, 25, 23, 0.52) 55%,
      rgba(26, 25, 23, 0.72) 100%
    );
  }

  .hero__eyebrow {
    position: relative;
    z-index: 2;
    grid-row: 2;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(247, 243, 238, 0.6);
    margin: 0;
    text-align: center;
  }

  .hero__title {
    position: relative;
    z-index: 2;
    grid-row: 3;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-self: center;
    min-width: 0;
    max-width: 100%;
    width: max-content;
    margin: 0.55rem 0 0;
    gap: 0.2em;
    line-height: 0.2;
  }

  .hero__title-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__title-main {
    font-family: var(--font-serif);
    font-size: 5rem;
    font-weight: 500;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 0.85;
    color: var(--color-cream);
    margin-right: -0.18em;
  }

  .hero__title-sub {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: rgba(247, 243, 238, 0.75);
    line-height: 0.2;
    padding-block: 0.45em;
  }

  .hero__cta {
    position: relative;
    z-index: 2;
    grid-row: 5;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream);
    border: 1px solid rgba(247, 243, 238, 0.45);
    padding: 0.9rem 2.25rem;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .hero__cta:hover {
    background-color: var(--color-terracotta);
    border-color: var(--color-terracotta);
  }

  .hero__cta-arrow {
    transition: transform 0.2s ease;
  }

  .hero__cta:hover .hero__cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 700px) {
    .hero__eyebrow {
      font-size: 0.55rem;
      letter-spacing: 0.14em;
      text-wrap: balance;
    }

    .hero__title-main {
      font-size: clamp(2.35rem, 12vw, 3.4rem);
      letter-spacing: 0.1em;
      margin-right: -0.1em;
    }

    .hero__title-sub {
      font-size: clamp(0.72rem, 3.6vw, 1.05rem);
    }

    .hero__cta {
      padding: 0.85rem 1.5rem;
      letter-spacing: 0.14em;
    }
  }
</style>
