---
---

<section class="hero" aria-label="Viktoria Restaurant — hlavní sekce">
  <div class="hero__bg">
    <img
      src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=2400&q=85&auto=format&fit=crop"
      alt=""
      role="presentation"
      fetchpriority="high"
      loading="eager"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <p class="hero__eyebrow">Autentická Ukrajinská Kuchyně</p>
  <h1 class="hero__title">
    <span class="hero__title-sr">Viktoria Restaurant</span>
    <span class="hero__title-main" aria-hidden="true">Viktoria</span>
    <span class="hero__title-sub" aria-hidden="true">
      {"Restaurant".split("").map((letter) => (
        <span>{letter}</span>
      ))}
    </span>
  </h1>
  <a href="#rezervace" class="hero__cta">
    Rezervace stolu
    <span aria-hidden="true" class="hero__cta-arrow">→</span>
  </a>
  <a href="#koncept" class="hero__scroll" aria-label="Přejít na obsah">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: grid;
    grid-template-rows: 0.5fr auto 0.5fr auto 1fr auto 1fr auto;
    justify-items: center;
    align-items: center;
    padding: 5.75rem clamp(1.5rem, 5vw, 4rem) 2.5rem;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(26, 25, 23, 0.18) 0%,
      rgba(26, 25, 23, 0.52) 55%,
      rgba(26, 25, 23, 0.72) 100%
    );
  }

  .hero__eyebrow {
    position: relative;
    z-index: 2;
    grid-row: 2;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(247, 243, 238, 0.6);
    margin: 0;
    text-align: center;
  }

  .hero__title {
    position: relative;
    z-index: 2;
    grid-row: 4;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: max-content;
    margin: 0;
    gap: 0.2em;
    line-height: 0.2;
  }

  .hero__title-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__title-main {
    font-family: var(--font-serif);
    font-size: 5rem;
    font-weight: 500;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 0.85;
    color: var(--color-cream);
    margin-right: -0.18em;
  }

  .hero__title-sub {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: rgba(247, 243, 238, 0.75);
    line-height: 0.2;
    padding-block: 0.45em;
  }

  .hero__cta {
    position: relative;
    z-index: 2;
    grid-row: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream);
    border: 1px solid rgba(247, 243, 238, 0.45);
    padding: 0.9rem 2.25rem;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .hero__cta:hover {
    background-color: var(--color-terracotta);
    border-color: var(--color-terracotta);
  }

  .hero__cta-arrow {
    transition: transform 0.2s ease;
  }

  .hero__cta:hover .hero__cta-arrow {
    transform: translateX(3px);
  }

  .hero__scroll {
    position: relative;
    z-index: 2;
    grid-row: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, transparent, rgba(247, 243, 238, 0.45));
    animation: scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0% {
      transform: scaleY(0);
      transform-origin: top;
      opacity: 0;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 1;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
      opacity: 1;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
      opacity: 0;
    }
  }
</style>
