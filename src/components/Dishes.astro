---
const dishes = [
  {
    id: "borscht",
    name: "Boršč",
    tagline: "Kyjevský řepný vývar s hovězím, zelím a čerstvou smetanou",
    image:
      "https://images.unsplash.com/photo-1547592180-85f173990554?w=800&q=80&auto=format&fit=crop",
    alt: "Tradiční boršč — hluboká sytá červená polévka s kapkou zakysané smetany",
  },
  {
    id: "varenyky",
    name: "Varenyky",
    tagline: "Ručně tvarované knedlíky plněné bramborem a sýrem, se smetanou",
    image:
      "https://images.unsplash.com/photo-1603360946369-dc9bb6258143?w=800&q=80&auto=format&fit=crop",
    alt: "Varenyky — měkké ručně vyráběné knedlíky",
  },
  {
    id: "holubtsi",
    name: "Holubtsi",
    tagline: "Zelné závitky plněné masem a rýží, dušené v rajčatové omáčce",
    image:
      "https://images.unsplash.com/photo-1519984388953-d2406bc725e1?w=800&q=80&auto=format&fit=crop",
    alt: "Holubtsi — tradiční ukrajisnké zelné závitky",
  },
  {
    id: "deruny",
    name: "Deruny",
    tagline: "Zlatavé bramborové placky s domácí zakysanou smetanou a lososem",
    image:
      "https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?w=800&q=80&auto=format&fit=crop",
    alt: "Deruny — tradiční bramborové placky",
  },
];
---

<section class="dishes section-padding" id="speciality" aria-labelledby="dishes-heading">
  <div class="site-container">

    <div class="dishes__header" data-reveal>
      <p class="eyebrow">Speciality</p>
      <h2 id="dishes-heading" class="dishes__title">Naše speciality</h2>
      <p class="dishes__intro">
        Čtyři jídla, která definují Viktorii. Každé připravené přesně podle 
        tradičního receptu, s pečlivostí domácí kuchyně.
      </p>
    </div>

    <div class="dishes__grid">
      {
        dishes.map((dish, i) => (
          <article class="dish" data-reveal data-reveal-delay={String(i + 1) as "1" | "2" | "3" | "4"}>
            <div class="dish__image">
              <div class="parallax-media" data-parallax={String(5 + (i % 3) * 2)}>
                <img src={dish.image} alt={dish.alt} loading="lazy" />
              </div>
            </div>
            <div class="dish__info">
              <h3 class="dish__name">{dish.name}</h3>
              <p class="dish__tagline">{dish.tagline}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="dishes__footer" data-reveal>
      <a href="/menu" class="dishes__link">
        Zobrazit celý jídelní lístek
        <span aria-hidden="true" class="dishes__arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .dishes {
    background-color: var(--color-cream-dark);
  }

  .dishes__header {
    max-width: 580px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .dishes__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-heading);
    margin: 0 0 1.25rem;
  }

  .dishes__intro {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-charcoal-soft);
    max-width: 50ch;
    margin: 0;
  }

  .dishes__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin-bottom: clamp(3rem, 5vw, 4rem);
  }

  .dish {
    position: relative;
  }

  .dish__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background-color: var(--color-border);
  }

  .dish__image::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(26, 25, 23, 0.88) 0%,
      rgba(26, 25, 23, 0.45) 42%,
      rgba(26, 25, 23, 0) 72%
    );
    pointer-events: none;
  }

  .dish__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dish:hover .dish__image img {
    transform: scale(1.05);
  }

  .dish__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 1.35rem 1.1rem 1.2rem;
  }

  .dish__name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 500;
    color: var(--color-cream);
    margin: 0 0 0.35rem;
  }

  .dish__tagline {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(247, 243, 238, 0.78);
    margin: 0;
  }

  .dishes__footer {
    text-align: center;
  }

  .dishes__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-charcoal);
    padding-bottom: 0.15rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .dishes__link:hover {
    color: var(--color-terracotta);
    border-color: var(--color-terracotta);
  }

  .dishes__arrow {
    transition: transform 0.2s ease;
  }

  .dishes__link:hover .dishes__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .dishes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .dishes__grid {
      grid-template-columns: 1fr;
      max-width: 380px;
      gap: 1.25rem;
    }

    .dish__info {
      padding: 1.6rem 1.15rem 1.25rem;
    }
  }
</style>
